# Configure these values in Render's Environment settings. Do not commit real credentials.
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=your_mysql_host
DB_PORT=4000
DB_NAME=opportunity_radar
DB_SSL=true
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Configure these only in the Render API and Cron service environments.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=reminders@example.com
SMTP_USE_STARTTLS=true
REMINDER_WINDOWS_DAYS=7,3,1
